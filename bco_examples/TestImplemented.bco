program TestImplemented() returns none {                                            // program def, nonetype return 

    int Num_1 = 58907;                                                              // integer definition
    int Num_2 = 6;                                                                      // another integer definition
    bool Boolean = FALSE;                                                           // boolean definition
    string Str = "This is a string!!!";   // string definition

    int Add = 5 + 5;                                                                // addition, assignment
    int Sub = 5 - 5;                                                               // subtraction, assignment
    int Mult = 7 * 7;                                                               // multiplication, division
    int Div = 10 / 5;

    cprint("Printing test...");
    cprint("...success.");
    cprint("Printing variable values...");
    cprint(Num_1);                                                   // printing to terminal
    cprint(Num_2);
    cprint(Boolean);
    cprint(Str);
    cprint(Add);
    cprint(Sub);
    cprint(Mult);
    cprint(Div);
    cprint("...success. Program ending.");

    return NONE;

};